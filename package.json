{
  "name": "localmark",
  "version": "1.0.0",
  "description": "本地隐私优先的极速 PDF 转 Markdown 桌面工作台",
  "main": "dist-electron/main.js",
  "author": "LocalMark Team",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && electron-builder --dir",
    "build:dir": "vue-tsc --noEmit && vite build && electron-builder --dir",
    "build:portable": "vue-tsc --noEmit && vite build && electron-builder --win portable",
    "build:setup": "vue-tsc --noEmit && vite build && electron-builder --win nsis",
    "build:win": "vue-tsc --noEmit && vite build && electron-builder --win",
    "icon": "python scripts/make_icon.py",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.localmark.app",
    "productName": "LocalMark",
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        "portable",
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LocalMark",
      "artifactName": "LocalMark-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "LocalMark-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "@firecrawl/pdf-inspector": "^1.25.0",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^0.441.0",
    "pdfjs-dist": "^3.11.174",
    "pinia": "^2.2.2",
    "tailwind-merge": "^2.5.2",
    "vue": "^3.5.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "@vitejs/plugin-vue": "^5.1.3",
    "autoprefixer": "^10.4.20",
    "electron": "^32.1.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.6.2",
    "vite": "^5.4.5",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vue-tsc": "^2.1.6"
  }
}
